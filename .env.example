DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=mtgproject

# Session signing (set a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string
# Set to 1 when serving over HTTPS so the session cookie is secure-only
# SESSION_SECURE=1

# When using local TLS (certs/), plain http:// on PORT is not served. Optional redirect:
# defaults to PORT+1 (e.g. 3002). Set to 0 to disable.
# HTTP_REDIRECT_PORT=3002

# Optional: extra cleartext HTTP port while TLS is on (camera/mic still need https:// server.url).
# CAPACITOR_HTTP_PORT=3100

# After a one-time DB migration from single-tenant data, sign in with this account
# LEGACY_ACCOUNT_EMAIL=legacy@mtg-archive.local
# LEGACY_ACCOUNT_PASSWORD=changeme

# CORS — whitelist (comma-separated). Leave unset in local dev for localhost/
# 127.0.0.1 + Capacitor defaults. For phone-on-LAN testing, list that origin too:
# ALLOWED_ORIGIN=https://localhost:3001,https://192.168.0.20:3001
# ALLOWED_ORIGIN=https://yourdomain.com

# ── Transactional email — password resets AND email confirmations ────────────
# Nothing is sent while neither transport is configured: the app logs the link
# to the server console instead. Fine for local dev, useless in production.
#
# PREFER THE HTTPS API IN PRODUCTION. Railway blocks outbound SMTP (ports
# 25/465/587/2525) on every plan below Pro, so the SMTP settings below will fail
# to connect there. The API key path is one HTTPS POST and is not affected.
# RESEND_API_KEY=re_yourapikey
# EMAIL_FROM=noreply@yourdomain.com
#
# SMTP alternative (works anywhere outbound SMTP is permitted):
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=1
# SMTP_USER=resend
# SMTP_PASS=re_yourapikey

# Public base URL. Used for the links we email AND as the base for every OAuth
# redirect URI, which must match what is registered with each provider byte for
# byte — so set this in any environment that has a stable hostname.
# APP_URL=https://yourdomain.com

# ── Federated sign-in ────────────────────────────────────────────────────────
# Each provider is optional and independent: only the ones whose variables are
# fully set appear as buttons on the sign-in screen. See docs/auth-setup.md for
# where to click in each console.
#
# Redirect URI to register: <APP_URL>/api/auth/oauth/<provider>/callback

# Google — console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx

# Discord — discord.com/developers/applications → OAuth2
# DISCORD_CLIENT_ID=xxxx
# DISCORD_CLIENT_SECRET=xxxx

# Apple — developer.apple.com (paid account required). APPLE_CLIENT_ID is the
# Services ID, not the app's bundle id. The private key is the .p8 file's
# contents; \n escapes are accepted so it fits on one line.
# APPLE_CLIENT_ID=com.yourdomain.web
# APPLE_TEAM_ID=XXXXXXXXXX
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIGT...\n-----END PRIVATE KEY-----"

# Automated release notes: same secret must be set on the server and used by scripts/changelog-add.js
# (Authorization: Bearer <secret> on POST /api/internal/changelog-ingest)
# CHANGELOG_INGEST_SECRET=generate-a-long-random-string
# Optional override for changelog:add (defaults to http://127.0.0.1:PORT).
# If the dev server runs HTTPS (mkcert), use https://127.0.0.1:3001 — the CLI trusts localhost TLS.
# MTG_API_URL=https://127.0.0.1:3001

# Foundation Evaluation Lab: default account for Account-decks source / --user
# (injected into admin-only /foundation-lab.html; do not put a personal address in public JS)
# FOUNDATION_LAB_DEFAULT_ACCOUNT=you@example.com
