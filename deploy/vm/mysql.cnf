[mysqld]
# Box has 7.8 GB shared with other stacks; hot data (catalog, decks, recent
# prices) fits easily. card_price_daily is 3 GB but is read by date range.
innodb_buffer_pool_size = 1G
innodb_redo_log_capacity = 1G
# ~250 MB of instrumentation nobody reads (see scripts/db-memory-report.js)
performance_schema = OFF
max_allowed_packet = 256M
character_set_server = utf8mb4
collation_server = utf8mb4_0900_ai_ci
