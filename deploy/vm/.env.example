# /opt/docker/mtgarchive/.env on the VM (chmod 600). Never commit the real one.
# Generate each secret with: openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48

# Deployed commit; ops/deploy.sh rewrites this line on every deploy.
GIT_COMMIT=

# MySQL (db service). DB_USER/DB_PASS is the app's own non-root user.
MYSQL_ROOT_PASSWORD=
DB_NAME=mtgarchive
DB_USER=mtg
DB_PASS=

SESSION_SECRET=
APP_URL=https://tensorcrafted.com
ALLOWED_ORIGIN=https://tensorcrafted.com

# Same values as the local .env of anyone who runs `npm run changelog:add`
# or `npm run semantics:push` against prod.
CHANGELOG_INGEST_SECRET=
SEMANTICS_INGEST_SECRET=

# Background jobs (on in prod)
PRICE_CRON_ENABLED=1
FP_CRON_ENABLED=1

# Optional; left empty in prod as of 2026-11-02 (no email transport, no OAuth).
# RESEND_API_KEY=
# EMAIL_FROM=
# TCG_PUBLIC_KEY=
# TCG_PRIVATE_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
